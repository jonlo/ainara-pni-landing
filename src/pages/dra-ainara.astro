---
import BaseLayout from "../layouts/BaseLayout.astro";
import InnerHero from "../components/InnerHero.astro";
import { paths, site } from "../config/site";
---
<BaseLayout title="Conoce a la Dra. Ainara | Medicina y PNI en Bilbao" description="Conoce el enfoque de Ainara, médico con formación en PNI Clínica, y su forma de trabajar en consulta." canonicalPath={paths.doctor}>
  <InnerHero eyebrow="Conoce a Ainara" title="La persona detrás de la consulta" lead="Medicina, escucha y una mirada al contexto de cada persona." />
  <section class="section"><div class="container split-section"><div><p class="eyebrow">Dra. Ainara</p><h2>Una consulta que empieza por escuchar</h2></div><div><p>Ainara es médico con formación avanzada en Psiconeuroinmunología Clínica. Su trabajo parte de conocer qué te preocupa, cómo ha evolucionado y cómo afecta a tu vida cotidiana.</p><p>La historia clínica y los informes se ponen en contexto con aspectos como el descanso, la alimentación, la actividad física y el estrés cuando son relevantes.</p><p>La valoración permite conversar sobre los siguientes pasos y resolver las dudas que surjan durante la consulta.</p></div></div></section>
  <section class="section section-tint"><div class="container"><p class="eyebrow">Formación y trayectoria</p><h2>La base de su trabajo</h2><div class="expectation-grid"><article><h3>Medicina</h3><p>Formación médica como punto de partida de la valoración clínica.</p></article><article><h3>{site.doctor.pniEducation.title}</h3><p>{site.doctor.pniEducation.type} en PNI Clínica.</p>{site.doctor.pniEducation.institution && <p>{site.doctor.pniEducation.institution}</p>}</article>{site.doctor.experience.summary && <article><h3>Trayectoria profesional</h3><p>{site.doctor.experience.summary}</p></article>}</div>{site.doctor.registration.number && <p>N.º de colegiación: {site.doctor.registration.number}</p>}</div></section>
  <section class="final-cta"><div class="container"><h2>Conoce cómo será tu primera visita</h2><p>Qué se revisa en consulta y cómo puedes prepararla.</p><a class="button button-light" href={paths.consultation}>Conocer la consulta</a></div></section>
</BaseLayout>
