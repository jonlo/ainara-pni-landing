---
import BaseLayout from "../layouts/BaseLayout.astro"; import InnerHero from "../components/InnerHero.astro"; import Credentials from "../components/Credentials.astro"; import { paths } from "../config/site";
---
<BaseLayout title="Dra. Ainara | Médico y formación en PNI Clínica en Bilbao" description="Conoce la formación y el enfoque profesional de la Dra. Ainara, médico con formación avanzada en Psiconeuroinmunología Clínica." canonicalPath={paths.doctor}>
  <InnerHero eyebrow="Autoridad profesional" title="Dra. Ainara" lead="Médico con formación avanzada en Psiconeuroinmunología Clínica." />
  <section class="section"><div class="container content-grid"><aside><Credentials /></aside><article><h2>Formación médica y una mirada amplia</h2><p>Ainara es médico y cuenta con años de experiencia profesional. Además, cuenta con formación avanzada en Psiconeuroinmunología Clínica.</p><p>Su trabajo parte de una valoración médica individualizada e incorpora, cuando resulte apropiado, una mirada sobre el descanso, la alimentación, la actividad física, el estrés y otros factores del contexto personal.</p><blockquote>Un enfoque global sin renunciar al rigor y al criterio médico.</blockquote><button class="button js-booking-open" type="button">Ver disponibilidad</button></article></div></section>
  <section class="section section-tint"><div class="container"><p class="eyebrow">Forma de trabajar</p><h2>Principios que orientan la consulta</h2><div class="principles-grid"><article><strong>01</strong><h3>Escuchar antes de concluir</h3><p>Comprender la historia, la evolución y el contexto antes de plantear los siguientes pasos.</p></article><article><strong>02</strong><h3>Integrar sin simplificar</h3><p>Considerar diferentes áreas sin reducir problemas complejos a una explicación única.</p></article><article><strong>03</strong><h3>Individualizar</h3><p>Valorar qué información y recomendaciones pueden resultar apropiadas en cada caso.</p></article><article><strong>04</strong><h3>Revisar y adaptar</h3><p>Observar la evolución y ajustar el plan o derivar cuando tenga sentido.</p></article></div></div></section>
  <section class="section"><div class="container split-section"><div><p class="eyebrow">Confianza profesional</p><h2>Información que se completará antes de publicar</h2></div><div><p>La web está preparada para mostrar la trayectoria, la institución de formación, la colegiación y los datos del centro cuando hayan sido confirmados.</p><p>No se publicarán credenciales incompletas ni datos provisionales como si fueran definitivos.</p><a class="arrow-link" href={paths.consultation}>Conocer la consulta <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
