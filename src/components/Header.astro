    <a class="brand" href={paths.home} aria-label={`${site.name}, inicio`}>
      <span>{site.doctor.firstName}</span><small>Medicina · PNI</small>
    </a>
    <nav aria-label="Navegación principal">
      <a href={paths.pniBilbao}>PNI</a><a href={paths.doctor}>Dra. Ainara</a><a href={paths.consultation}>La consulta</a><a href={paths.resources}>Recursos</a>
