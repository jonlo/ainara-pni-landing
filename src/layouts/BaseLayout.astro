---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingMock from "../components/BookingMock.astro";
import { site } from "../config/site";

interface Props { title?: string; description?: string; canonicalPath?: string; }
const { title = site.defaultTitle, description = site.defaultDescription, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : undefined;
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const socialImage = Astro.site ? new URL(`${assetBase}og.png`, Astro.site) : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#28737a" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <BookingMock />
  </body>
</html>
